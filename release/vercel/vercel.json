{
  "version": 2,
  "builds": [
    {
      "src": "src/static/**",
      "use": "@vercel/static"
    },
    {
      "src": "src/api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "src/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
