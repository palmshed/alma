{
  "version": 2,
  "builds": [
    {
      "src": "src/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "src/api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/api/index.py"
    },
    {
      "src": "/(terms|privacy|contact|help)",
      "dest": "src/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/src/frontend/$1"
    }
  ]
}
